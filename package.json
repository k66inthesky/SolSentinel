{
  "name": "solsentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validator": "scripts/validator.sh",
    "build:programs": "anchor build && cp target/idl/*.json target/types/sentinel_vault.ts target/types/mock_swap.ts agent/idl/",
    "deploy:local": "tsx agent/src/deploy.ts local",
    "deploy:devnet": "solana program deploy -u devnet target/deploy/sentinel_vault.so --program-id target/deploy/sentinel_vault-keypair.json && solana program deploy -u devnet target/deploy/mock_swap.so --program-id target/deploy/mock_swap-keypair.json && tsx agent/src/deploy.ts devnet",
    "backtest": "tsx agent/src/backtest.ts",
    "walkforward": "tsx agent/src/tune.ts",
    "agent": "tsx agent/src/main.ts",
    "test": "tsx --test agent/test/vault.test.ts",
    "demo:guard": "tsx agent/src/guard-demo.ts",
    "typecheck": "tsc -p .",
    "validator:fork": "scripts/fork-validator.sh",
    "test:fork": "tsx --test agent/test/yield-fork.test.ts",
    "yield": "NODE_USE_ENV_PROXY=1 tsx agent/src/yield-agent.ts",
    "yield:deploy": "NODE_USE_ENV_PROXY=1 tsx agent/src/yield-deploy.ts"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.2",
    "@anthropic-ai/sdk": "^1.6.0",
    "@jup-ag/lend": "^0.4.0",
    "@kamino-finance/klend-sdk": "^13.0.6",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}